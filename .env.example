# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=roommate_finder_verify

# ── Anthropic Claude API ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── App Branding ──────────────────────────────────────────────────────────────
APP_NAME=Roommate Finder
APP_TAGLINE=Find roommates who share your culture, values, and lifestyle.

# ── Currency ──────────────────────────────────────────────────────────────────
CURRENCY=USD
CURRENCY_SYMBOL=$

# ── Community Context (optional — describes your user base to the AI) ─────────
# Leave blank for a fully general service.
# The AI will always ask about religion, ethnicity, diet, language, and lifestyle
# regardless — this just primes it with context about your community.

# General (no community context):
COMMUNITY_VALUES=

# South Asian diaspora:
# COMMUNITY_VALUES=Many users are Indian, Pakistani, or Bangladeshi. Common preferences include vegetarian or halal diet, Hindi/Urdu/Punjabi/Bengali speakers, and family-friendly households.

# Muslim community:
# COMMUNITY_VALUES=Users are Muslim. Halal household, no alcohol, prayer-friendly, and gender preferences (brothers-only or sisters-only) are common requirements.

# Jewish community:
# COMMUNITY_VALUES=Users are Jewish. Kosher kitchen, Shabbat observance, and Jewish-only households are common preferences.

# Latino/Hispanic community:
# COMMUNITY_VALUES=Many users are Latino. Spanish speakers preferred, family-friendly environments common.

# Nigerian diaspora:
# COMMUNITY_VALUES=Many users are Nigerian. Christian or Muslim households common, Yoruba/Igbo/Hausa speakers.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Spam Guard Controls ───────────────────────────────────────────────────────
# Rate limits per user
SPAM_PER_MINUTE=5          # Max messages per minute
SPAM_PER_HOUR=30           # Max messages per hour
SPAM_PER_DAY=100           # Max messages per day

# Listing abuse
MAX_LISTINGS_USER=2        # Max active listings per phone number

# Strike system
SPAM_STRIKES_WARN=2        # Strikes before throttle
SPAM_STRIKES_BAN=5         # Strikes before ban
SPAM_THROTTLE_MINUTES=30   # Throttle duration in minutes
SPAM_BAN_HOURS=24          # Ban duration in hours

# Flood detection
SPAM_FLOOD_WINDOW=5        # Block if same message sent N times in 60s

# Admin panel (REQUIRED to access /admin/* endpoints)
ADMIN_SECRET=your_strong_secret_here
